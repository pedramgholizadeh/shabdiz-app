APP_ENV=production
APP_DEBUG=0
APP_URL=https://apps.webiro.ir/shabdiz
APP_BASE_PATH=/shabdiz
APP_KEY=
APP_TIMEZONE=Asia/Tehran

DB_HOST=localhost
DB_PORT=3306
DB_NAME=shabdiz
DB_USER=shabdiz
DB_PASS=

# resend (default): Resend API → host SMTP → PHP mail() fallback chain
# smtp: host SMTP → PHP mail()   |   mail: PHP mail() only   |   log: staging
MAIL_DRIVER=resend
MAIL_FROM=no-reply@webiro.ir
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
OTP_TTL_SECONDS=300

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=مدیر شب‌دیز
ADMIN_PASSWORD_HASH=
