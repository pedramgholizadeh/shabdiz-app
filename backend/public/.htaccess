DirectoryIndex index.php

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The bare deployment root points visitors to the open-source repository.
    # The admin panel and API stay reachable at /admin and /api/*.
    RewriteRule ^$ https://github.com/pedramgholizadeh/shabdiz-app [R=302,L]

    # Preserve the Authorization header for the Bearer-token API.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Never serve private application paths.
    RewriteRule ^(app|config|migrations|scripts|storage)(/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.(env|git|htaccess|DS_Store)$">
    Require all denied
</FilesMatch>

<Files "composer.json">
    Require all denied
</Files>
