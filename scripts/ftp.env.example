# ============================================================
# FTP Deployment Configuration for Shabdiz Backend
# Copy this file to ftp.env and fill in your values
# ============================================================

# FTP Server (e.g., ftp.webirox.ir or your hosting provider's FTP host)
FTP_HOST=""

# FTP Username
FTP_USER=""

# FTP Password
FTP_PASS=""

# FTP Port (default: 21)
FTP_PORT=21

# Remote directory on the server where backend/ contents will be uploaded
# For apps.webirox.ir/shabdiz, this is typically the document root or shabdiz/ subdirectory
# Example: /shabdiz  or  /public_html/shabdiz  or  /var/www/shabdiz
FTP_REMOTE_DIR="/shabdiz"

# Use passive mode (true/false) - usually true for modern hosting
FTP_PASSIVE="true"

# ============================================================
# Notes:
# - config.php is NEVER uploaded (contains live credentials)
# - data/*.sqlite is never uploaded (SQLite database with user data)
# - .git/ and .DS_Store are excluded
# - Run with --apply to actually upload: bash scripts/sync-ftp.sh --apply
# ============================================================