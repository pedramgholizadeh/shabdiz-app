# ── ShabDiz deploy configuration ────────────────────────────────
# Copy to config.env and fill in. config.env is gitignored — never commit it.
# Target: https://apps.webiro.ir/shabdiz  (admin panel + API)

SITE_URL=https://apps.webiro.ir/shabdiz
APP_BASE_PATH=/shabdiz
SITE_RESOLVE_IP=
CURL_INSECURE=false

# Auto-generated on the first deploy if empty.
APP_KEY=
DEPLOY_TOKEN=

# FTP account for the apps subdomain (flat docroot or the shabdiz subfolder).
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SSL=true
FTP_PASSIVE=true
FTP_REMOTE_ROOT=/path/to/apps.webiro.ir/shabdiz

# MySQL database on the host.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# OTP email. MAIL_DRIVER=mail uses PHP mail() on the host.
# Use MAIL_DRIVER=log for staging (codes are written to storage/logs/mail.log).
MAIL_DRIVER=mail
MAIL_FROM=no-reply@webiro.ir
OTP_TTL_SECONDS=300

# Admin account, created by `deploy.sh setup` (never stored in plaintext server-side).
ADMIN_EMAIL=
ADMIN_NAME="مدیر شب‌دیز"
ADMIN_PASSWORD=
